# --- Database -------------------------------------------------------------
# Local: SQLite file inside /prisma. Production: a Postgres URL (Neon / Supabase)
DATABASE_URL="file:./dev.db"

# --- Public site URL (used for sitemap, canonical links, Open Graph) -------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Admin login (/admin) ----------------------------------------------------
ADMIN_EMAIL="admin@karintravel.am"
ADMIN_PASSWORD="change-me-please"
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-with-a-long-random-string"

# --- Telegram notifications for new enquiries ----------------------------
# 1) Create a bot with @BotFather and paste its token here.
# 2) Add the bot to the agency's group (or write to it), then open
#    https://api.telegram.org/bot<TOKEN>/getUpdates to find the chat id.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# --- Optional e-mail notifications (any SMTP provider) ---------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
NOTIFY_EMAIL_TO=""
NOTIFY_EMAIL_FROM=""

# --- Analytics (leave empty to disable) ----------------------------------
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""

# Shows the floating "Aa" font picker on the public site while choosing fonts.
# Set to 0 (or remove) before launch.
NEXT_PUBLIC_SHOW_FONT_PICKER="1"
